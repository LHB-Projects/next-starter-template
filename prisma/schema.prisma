datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Employee {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  role     String @default("employee")
}