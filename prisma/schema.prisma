datasource db {
  provider = "sqlite" // you can change this later to postgresql or mysql
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  role     String @default("employee")
}
